# Server (required at build + Nitro boot)
NUXT_RESEND_API_KEY=
NUXT_LEADS_FROM_EMAIL=
NUXT_LEADS_TO_EMAIL=
NUXT_PROD_LEADS_TO_EMAIL=
NUXT_TELEGRAM_BOT_TOKEN=
NUXT_TELEGRAM_CHAT_ID=-
NUXT_TURNSTILE_SECRET=
# Optional. Empty skips KeyCRM. Create the key in KeyCRM → Settings → General.
NUXT_KEYCRM_API_KEY=
# Lead-status webhook. Empty rejects every status callback. See runbooks/ads-lead-events.md.
NUXT_KEYCRM_WEBHOOK_SECRET=
# Text field uuids that record a sent qualified_lead / booked_move. Empty sends without a mark.
NUXT_KEYCRM_ADS_QUALIFIED_FIELD=
NUXT_KEYCRM_ADS_BOOKED_FIELD=
# Optional. Empty skips that destination. Google Ads uses the Data Manager API, not a developer token.
NUXT_GA4_MEASUREMENT_ID=
NUXT_GA4_API_SECRET=
NUXT_META_PIXEL_ID=
NUXT_META_CAPI_TOKEN=
NUXT_GOOGLE_ADS_CUSTOMER_ID=
NUXT_GOOGLE_ADS_LOGIN_CUSTOMER_ID=
NUXT_GOOGLE_ADS_CLIENT_ID=
NUXT_GOOGLE_ADS_CLIENT_SECRET=
NUXT_GOOGLE_ADS_REFRESH_TOKEN=
NUXT_GOOGLE_ADS_QUALIFIED_ACTION_ID=
NUXT_GOOGLE_ADS_BOOKED_ACTION_ID=

# Nitro (optional overrides)
HOST=0.0.0.0
PORT=3000
